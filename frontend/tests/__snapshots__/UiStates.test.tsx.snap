exports[`shared UI states > renders the permission variant 1`] = `
<div
  class="ui-dialog-backdrop"
>
  <section
    aria-describedby=":r4:"
    aria-labelledby=":r3:"
    aria-modal="true"
    class="ui-dialog"
    role="alertdialog"
    tabindex="-1"
  >
    <div
      class="ui-dialog-heading"
    >
      <div>
        <span
          class="eyebrow"
        >
          CONFIRMATION
        </span>
        <h2
          id=":r3:"
        >
          Allow workspace access?
        </h2>
      </div>
      <button
        aria-label="Close dialog"
        class="ui-dialog-close"
        title="Close dialog"
        type="button"
      >
        <svg
          aria-hidden="true"
          class="lucide lucide-x"
          fill="none"
          height="17"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="17"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M18 6 6 18"
          />
          <path
            d="m6 6 12 12"
          />
        </svg>
      </button>
    </div>
    <div
      class="ui-dialog-body"
    >
      <div
        aria-hidden="true"
        class="ui-dialog-icon"
      >
        <svg
          class="lucide lucide-triangle-alert"
          fill="none"
          height="19"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="19"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"
          />
          <path
            d="M12 9v4"
          />
          <path
            d="M12 17h.01"
          />
        </svg>
      </div>
      <div>
        <p
          id=":r4:"
        >
          The action needs workspace permission.
        </p>
        <dl
          aria-label="Approval request details"
          class="ui-dialog-approval-details"
        >
          <div>
            <dt>
              TOOL
            </dt>
            <dd>
              <code>
                terminal.exec
              </code>
            </dd>
          </div>
          <div>
            <dt>
              COMMAND
            </dt>
            <dd>
              <code>
                python -c print(1)
              </code>
            </dd>
          </div>
          <div>
            <dt>
              PATHS
            </dt>
            <dd>
              <code>
                C:/workspace/output.txt
              </code>
            </dd>
          </div>
          <div>
            <dt>
              WORKDIR
            </dt>
            <dd>
              <code>
                C:/workspace
              </code>
            </dd>
          </div>
          <div>
            <dt>
              IMPACT
            </dt>
            <dd>
              starts one local process
            </dd>
          </div>
          <div>
            <dt>
              SCOPE
            </dt>
            <dd>
              ONCE
            </dd>
          </div>
        </dl>
      </div>
    </div>
    <div
      class="ui-dialog-actions"
    >
      <button
        type="button"
      >
        CANCEL
      </button>
      <button
        class="ui-dialog-confirm ui-dialog-danger"
        type="button"
      >
        CONFIRM
      </button>
    </div>
  </section>
</div>
`;
