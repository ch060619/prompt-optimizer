      </button>
    </div>
  </div>
</section>
`;

exports[`shared UI states > renders the install variant 1`] = `
<div
  class="ui-dialog-backdrop"
>
  <section
    aria-describedby=":r6:"
    aria-labelledby=":r5:"
    aria-modal="true"
    class="ui-dialog"
    role="dialog"
    tabindex="-1"
  >
    <div
      class="ui-dialog-heading"
    >
      <div>
        <span
          class="eyebrow"
        >
          CONFIRMATION
        </span>
        <h2
          id=":r5:"
        >
          Install local model?
        </h2>
      </div>
      <button
        aria-label="Close dialog"
        class="ui-dialog-close"
        title="Close dialog"
        type="button"
      >
        <svg
          aria-hidden="true"
          class="lucide lucide-x"
          fill="none"
          height="17"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="17"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M18 6 6 18"
          />
          <path
            d="m6 6 12 12"
          />
        </svg>
      </button>
    </div>
    <div
      class="ui-dialog-body"
    >
      <div
        aria-hidden="true"
        class="ui-dialog-icon"
      >
        <svg
          class="lucide lucide-download"
          fill="none"
          height="19"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="19"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"
          />
          <polyline
            points="7 10 12 15 17 10"
          />
          <line
            x1="12"
            x2="12"
            y1="15"
            y2="3"
          />
        </svg>
      </div>
      <div>
        <p
          id=":r6:"
        >
          The download will be verified before use.
        </p>
      </div>
    </div>
    <div
      class="ui-dialog-actions"
    >
      <button
        type="button"
      >
        CANCEL
      </button>
      <button
        class="ui-dialog-confirm"
        type="button"
      >
        CONFIRM
      </button>
    </div>
  </section>
</div>
`;

