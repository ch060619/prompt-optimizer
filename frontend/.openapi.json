  "components": {
    "schemas": {
      "AnalyzeRequest": {
        "properties": {
          "prompt": {
            "type": "string",
            "title": "Prompt"
          }
        },
        "type": "object",
        "required": [
          "prompt"
        ],
        "title": "AnalyzeRequest"
      },
      "AuthRequest": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 64,
            "minLength": 3,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 6,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "AuthRequest"
      },
      "EvaluateTaskRequest": {
        "properties": {
          "prompts": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Prompts"
          },
          "provider": {
            "type": "string",
            "enum": [
              "offline",
              "openai",
              "tongyi",
              "zhipu"
            ],
            "title": "Provider",
            "default": "offline"
          }
        },
        "type": "object",
        "required": [
          "prompts"
        ],
        "title": "EvaluateTaskRequest"
      },
      "ExportRequest": {
        "properties": {
          "version_id": {
            "type": "integer",
            "title": "Version Id"
          },
          "format": {
            "type": "string",
            "enum": [
              "md",
              "json",
              "txt",
              "csv"
            ],
            "title": "Format"
          },
          "output": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output"
          }
        },
        "type": "object",
        "required": [
          "version_id",
          "format"
        ],
        "title": "ExportRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OptimizeRequest": {
        "properties": {
          "prompt": {
            "type": "string",
            "title": "Prompt"
          },
          "template_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Template Id"
          },
          "variables": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Variables"
          },
          "provider": {
            "type": "string",
            "enum": [
              "offline",
              "openai",
              "tongyi",
              "zhipu"
            ],
            "title": "Provider",
            "default": "offline"
          }
        },
        "type": "object",
        "required": [
          "prompt"
        ],
        "title": "OptimizeRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
